PORT=8787
NODE_ENV=development
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
MARGIN_JWT_SECRET=
MARGIN_JWT_ISSUER=https://auth.your-domain.example
MARGIN_JWT_AUDIENCE=margin-bank-api
TOKEN_ENCRYPTION_KEY=
DATA_FILE=./data/margin-bank-data.json
# Optional for OAuth institutions in production:
PLAID_REDIRECT_URI=https://your-domain.example/plaid/oauth
# Sign in with Apple: the iOS app's bundle identifier (the identity token's audience). Required in production.
APPLE_BUNDLE_ID=com.your-company.margin
# Optional Sign in with Apple REST credentials (set all three or none). With them, the authorizationCode sent
# at sign-in is exchanged for a refresh token that DELETE /v1/account revokes at Apple (guideline 5.1.1(v)).
# APPLE_PRIVATE_KEY is the .p8 PEM; newlines may be written as literal \n on one line.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Lifetime of Margin sessions minted by POST /v1/auth/apple (whole days, 1-90).
MARGIN_SESSION_TTL_DAYS=30
# Ask Margin (optional; leave empty to disable POST /v1/ask). Requires `npm install`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Questions per rolling 24 hours across all users (per process), on top of 30 per user.
ASK_DAILY_GLOBAL_LIMIT=2000
