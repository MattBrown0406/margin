PORT=8787
NODE_ENV=development
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
MARGIN_JWT_SECRET=
MARGIN_JWT_ISSUER=https://auth.your-domain.example
MARGIN_JWT_AUDIENCE=margin-bank-api
TOKEN_ENCRYPTION_KEY=
DATA_FILE=./data/margin-bank-data.json
# Optional for OAuth institutions in production:
PLAID_REDIRECT_URI=https://your-domain.example/plaid/oauth
# Sign in with Apple: the iOS app's bundle identifier (the identity token's audience).
APPLE_BUNDLE_ID=com.your-company.margin
# Lifetime of Margin sessions minted by POST /v1/auth/apple (whole days, 1-365).
MARGIN_SESSION_TTL_DAYS=30
# Ask Margin (optional; leave empty to disable POST /v1/ask). Requires `npm install`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
